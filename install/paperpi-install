#!/usr/bin/env bash
# Install, update or remove PaperPi as a systemd service on a Raspberry Pi (Raspberry Pi OS
# trixie). Run it with sudo; "paperpi-install --help" lists the commands. Where everything
# goes, and why: docs/install-systemd.md. A new install is one command:
#
#   curl -fsSL https://raw.githubusercontent.com/txoof/PaperPi/main/install/paperpi-install | sudo bash
#
# Everything is inside main(), called on the last line: bash reads a script while it runs it,
# also from a pipe, and "update" replaces this file.

set -euo pipefail

REPO=https://github.com/txoof/PaperPi
# Empty: the newest release (see newest_release).
REF=''
# The uv version that installs PaperPi's Python packages (from uv.lock).
UV_VERSION=0.12.23

PREFIX=/opt/paperpi
CODE=$PREFIX/code
VENV=$PREFIX/venv
TOOLS=$PREFIX/tools
CONFIG_DIR=/etc/paperpi
CONFIG=$CONFIG_DIR/paperpi.toml
STATE_DIR=/var/lib/paperpi
UNIT=/etc/systemd/system/paperpi.service
COMMAND=/usr/local/bin/paperpi
SELF=/usr/local/sbin/paperpi-install
USER_NAME=paperpi
# What the install needs from Debian: git gets the code; the venv module makes PaperPi's
# Python environment; the compiler and header files build spidev, the SPI library.
APT_PACKAGES=(git python3-venv gcc python3-dev)
# The IT8951 screen sizes of the screen menu, in inches (epdlib's it8951 MODELS; a test
# checks they match).
IT8951_MODELS=(6 7.8 9.7 10.3)
# The Waveshare small screens of the screen menu, as "Waveshare's file name|name in the
# menu", by size, tested ones first (epdlib's waveshare MODELS; a test checks they match).
# The menu uses Waveshare's own notation, as on their files: 7in5 is 7.5 inch, 7in5_V2 its V2.
WAVESHARE_MODELS=(
    'epd1in02|1in02'
    'epd1in54|1in54'
    'epd1in54_V2|1in54_V2'
    'epd1in54b|1in54b, black/white only'
    'epd1in54b_V2|1in54b_V2, black/white only'
    'epd1in54c|1in54c, black/white only'
    'epd1in64g|1in64g, 4 colours'
    'epd2in13|2in13'
    'epd2in13_V2|2in13_V2'
    'epd2in13_V3|2in13_V3'
    'epd2in13_V4|2in13_V4'
    'epd2in13d|2in13d'
    'epd2in13g|2in13g, 4 colours'
    'epd2in13b_V3|2in13b_V3, black/white only'
    'epd2in13b_V4|2in13b_V4, black/white only'
    'epd2in13bc|2in13bc, black/white only'
    'epd2in15g|2in15g, 4 colours'
    'epd2in15b|2in15b, black/white only'
    'epd2in36g|2in36g, 4 colours'
    'epd2in66|2in66'
    'epd2in66g|2in66g, 4 colours'
    'epd2in66b|2in66b, black/white only'
    'epd2in7|2in7'
    'epd2in7_V2|2in7_V2'
    'epd2in7b|2in7b, black/white only'
    'epd2in7b_V2|2in7b_V2, black/white only'
    'epd2in9|2in9'
    'epd2in9_V2|2in9_V2'
    'epd2in9_V3|2in9_V3'
    'epd2in9d|2in9d'
    'epd2in9b_V3|2in9b_V3, black/white only'
    'epd2in9b_V4|2in9b_V4, black/white only'
    'epd2in9bc|2in9bc, black/white only'
    'epd3in0g|3in0g, 4 colours'
    'epd3in52|3in52'
    'epd3in7|3in7'
    'epd4in01f|4in01f, 7 colours'
    'epd4in2|4in2'
    'epd4in2_V2|4in2_V2'
    'epd4in2bc|4in2bc, black/white only'
    'epd4in26|4in26'
    'epd4in37g|4in37g, 4 colours'
    'epd5in65f|5in65f, 7 colours (tested)'
    'epd5in79|5in79'
    'epd5in79g|5in79g, 4 colours'
    'epd5in79b|5in79b, black/white only'
    'epd5in83|5in83 (tested)'
    'epd5in83_V2|5in83_V2'
    'epd5in83b_V2|5in83b_V2, black/white only'
    'epd5in83bc|5in83bc, black/white only'
    'epd7in3e|7in3e, 6 colours'
    'epd7in3f|7in3f, 7 colours'
    'epd7in3g|7in3g, 4 colours'
    'epd7in5_V2|7in5_V2 (tested)'
    'epd7in5|7in5'
    'epd7in5_HD|7in5_HD'
    'epd7in5_V2_old|7in5_V2_old'
    'epd7in5b_HD|7in5b_HD, black/white only'
    'epd7in5b_V2|7in5b_V2, black/white only'
    'epd7in5b_V2_old|7in5b_V2_old, black/white only'
    'epd7in5bc|7in5bc, black/white only'
    'epd13in3k|13in3k'
    'epd13in3b|13in3b, black/white only'
)

usage() {
    cat <<EOF
Usage: sudo paperpi-install COMMAND [OPTIONS]

Commands:
  install     install PaperPi in $PREFIX and start the paperpi service (the command
              when none is given and PaperPi is not installed yet)
  update      get the newest PaperPi (or --ref) and restart the service
  uninstall   stop the service and remove PaperPi; the config ($CONFIG_DIR) and the
              saved files ($STATE_DIR) stay, unless --purge

Options:
  --ref REF       branch, tag or commit to install, e.g. main for the newest code
                  (default: the newest release)
  --repo URL      where to get PaperPi from (default: $REPO)
  --display TYPE  install only, for a new config: the screen type: it8951, waveshare
                  (Waveshare's small screens) or virtual, which only saves pictures
                  (change it in the web interface later). Without it, install asks.
  --model MODEL   install only: the screen model, e.g. 9.7 for it8951, or the name of
                  Waveshare's file for the screen for waveshare, e.g. epd7in5_V2
  --vcom VCOM     install only: the vcom printed on the screen's cable, e.g. -1.90
  --yes           ask nothing: install missing packages, use the virtual screen unless
                  --display is given, and don't restart the Pi (it says when one is
                  needed). Also what happens without a terminal to ask in.
  --purge         uninstall only: also remove the config, the saved files and the
                  $USER_NAME user
EOF
}

step() { printf '\n==> %s\n' "$*"; }
fail() { printf 'paperpi-install: %s\n' "$*" >&2; exit 1; }

# ask PROMPT DEFAULT: the answer typed in the terminal (in ANSWER), or DEFAULT for an empty
# answer, with --yes or without a terminal. It reads the terminal itself, because with
# "curl ... | sudo bash" the script's input is the pipe.
ask() {
    ANSWER=''
    if [[ $ASK == yes ]]; then
        read -r -p "$1" ANSWER </dev/tty || fail "no answer (the input ended)"
    fi
    ANSWER=${ANSWER:-$2}
}

yes_no() {
    ask "$1 [Y/n] " y
    [[ $ANSWER == [Yy]* ]]
}

check_system() {
    [[ $EUID -eq 0 ]] || fail "run it with sudo"
    command -v systemctl >/dev/null || fail "systemd is needed"
    command -v apt-get >/dev/null || fail "this works on Raspberry Pi OS (trixie) only"
    python3 -c 'import sys; sys.exit(sys.version_info < (3, 13))' 2>/dev/null \
        || fail "Python 3.13 or newer is needed: Raspberry Pi OS trixie has it"
}

get_apt_packages() {
    local missing=() package
    for package in "${APT_PACKAGES[@]}"; do
        dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'ok installed' \
            || missing+=("$package")
    done
    [[ ${#missing[@]} -eq 0 ]] && return
    step "Installing what the install needs from Debian: ${missing[*]}"
    yes_no "    Install them?" || fail "these are needed: sudo apt install ${missing[*]}"
    apt-get update -qq
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}" >/dev/null
}

# pick COUNT [back]: a number from 1 to COUNT (0 too, without "back") typed in the
# terminal, in CHOICE; with "back", b is allowed too and returns 1. Asks again until the
# answer fits.
pick() {
    while true; do
        # An empty answer: 0 in the first menu, asked again in the others.
        if [[ -n ${2:-} ]]; then ask "  Number: " ''; else ask "  Number: " 0; fi
        [[ -n ${2:-} && $ANSWER == [Bb] ]] && return 1
        CHOICE=$ANSWER
        [[ $CHOICE =~ ^[0-9]+$ ]] && ((CHOICE <= $1)) && { [[ -z ${2:-} ]] || ((CHOICE > 0)); } \
            && return 0
        if [[ -n ${2:-} ]]; then echo "  Type a number, or b to go back."
        else echo "  Type a number from the list."; fi
    done
}

# The screen menu, unless --display was given or there is a config already. Sets
# DISPLAY_TYPE, MODEL and VCOM. Short lines, so it fits a small terminal.
choose_screen() {
    if [[ -n $DISPLAY_TYPE ]]; then
        check_model
        return
    fi
    if [[ -e $CONFIG ]]; then
        # Only to know whether SPI is needed; the config stays as it is.
        DISPLAY_TYPE=$(sed -nE 's/^type *= *"(it8951|waveshare)".*/\1/p' "$CONFIG" | head -n 1)
        DISPLAY_TYPE=${DISPLAY_TYPE:-virtual}
        return 0
    fi
    DISPLAY_TYPE=virtual
    [[ $ASK == yes ]] || return 0
    while true; do
        step "Which screen is connected?"
        echo "  1  Waveshare IT8951 board"
        echo "     (6 to 10.3 inch)"
        echo "  2  Waveshare e-Paper HAT, small"
        echo "     screen (1.02 to 13.3 inch)"
        echo "  0  none yet: choose it later in"
        echo "     the web interface"
        pick 2
        case $CHOICE in
            0) return 0 ;;
            1) choose_it8951 && break ;;
            2) choose_waveshare && break ;;
        esac
    done
    if [[ $DISPLAY_TYPE == it8951 && -z $VCOM ]]; then
        echo "  The vcom is printed on the screen's"
        echo "  ribbon cable, e.g. -1.90."
        while true; do
            ask "  vcom: " ''
            [[ $ANSWER =~ ^-[0-9]+(\.[0-9]+)?$ ]] \
                && awk -v v="$ANSWER" 'BEGIN { exit !(v >= -3.0 && v <= -0.5) }' && break
            echo "  Type the number on the cable:"
            echo "  between -3.0 and -0.5."
        done
        VCOM=$ANSWER
    fi
}

# --display waveshare needs a --model of the menu, checked before the long install.
check_model() {
    [[ $DISPLAY_TYPE == waveshare ]] || return 0
    local entry
    for entry in "${WAVESHARE_MODELS[@]}"; do
        [[ ${entry%%|*} == "$MODEL" ]] && return 0
    done
    fail "unknown Waveshare model '$MODEL'; the name of Waveshare's file for the screen, e.g." \
        "epd7in5_V2 (all names: $REPO/blob/main/docs/waveshare-screens.md)"
}

# The IT8951 sizes; returns 1 for "back".
choose_it8951() {
    local i
    step "Which size? (inches, on the box)"
    for i in "${!IT8951_MODELS[@]}"; do
        printf "  %d  %s\n" $((i + 1)) "${IT8951_MODELS[i]}"
    done
    echo "  b  back"
    pick ${#IT8951_MODELS[@]} back || return 1
    DISPLAY_TYPE=it8951 MODEL=${IT8951_MODELS[CHOICE - 1]}
}

# The Waveshare sizes (in two columns), then the models of that size; returns 1 for "back".
choose_waveshare() {
    local entry size sizes=() models=() i half
    for entry in "${WAVESHARE_MODELS[@]}"; do
        size=${entry#*|}
        size=${size%%[!0-9in]*}
        [[ ${#sizes[@]} -gt 0 && ${sizes[-1]} == "$size" ]] || sizes+=("$size")
    done
    while true; do
        step "Which size? (7in5 = 7.5 inch)"
        half=$(((${#sizes[@]} + 1) / 2))
        for ((i = 0; i < half; i++)); do
            printf "%3d  %-6s" $((i + 1)) "${sizes[i]}"
            ((i + half < ${#sizes[@]})) && printf "  %3d  %s" $((i + half + 1)) "${sizes[i + half]}"
            echo
        done
        echo "  b  back"
        pick ${#sizes[@]} back || return 1
        size=${sizes[CHOICE - 1]}
        models=()
        for entry in "${WAVESHARE_MODELS[@]}"; do
            [[ ${entry#*|} =~ ^$size([^0-9]|$) ]] && models+=("$entry")
        done
        step "Which $size model? (on the sticker)"
        for i in "${!models[@]}"; do
            printf "%3d  %s\n" $((i + 1)) "${models[i]#*|}"
        done
        echo "  b  back"
        pick ${#models[@]} back || continue
        DISPLAY_TYPE=waveshare MODEL=${models[CHOICE - 1]%%|*}
        echo "  On the HAT, set the Display Config"
        echo "  switch to B (most screens) and"
        echo "  Interface Config to 0."
        return 0
    done
}

# Turns on SPI for a real screen. Sets RESTART=yes when the Pi must restart before
# /dev/spidev0.0 is there.
turn_on_spi() {
    [[ $DISPLAY_TYPE == virtual || -e /dev/spidev0.0 ]] && return
    command -v raspi-config >/dev/null \
        || fail "SPI is off and raspi-config is missing; turn on SPI, then run this again"
    step "Turning on SPI, the data line to the screen"
    raspi-config nonint do_spi 0
    [[ -e /dev/spidev0.0 ]] || RESTART=yes
}

make_user() {
    if id -u "$USER_NAME" >/dev/null 2>&1; then
        step "User $USER_NAME is already there"
        return
    fi
    step "Making the user $USER_NAME (no login, no password; it only runs PaperPi)"
    useradd --system --user-group --home-dir "$STATE_DIR" --no-create-home \
        --shell /usr/sbin/nologin --comment PaperPi "$USER_NAME"
}

get_uv() {
    if [[ -x $TOOLS/bin/uv ]] && [[ $("$TOOLS/bin/uv" --version) == "uv $UV_VERSION"* ]]; then
        return
    fi
    step "Getting uv $UV_VERSION (installs PaperPi's Python packages) into $TOOLS"
    rm -rf "$TOOLS"
    python3 -m venv "$TOOLS"
    "$TOOLS/bin/pip" install --quiet --disable-pip-version-check "uv==$UV_VERSION"
}

# The newest release: its version tag (v2.0.0, or v2.0.0a1 for a test release, as
# .github/workflows/release.yml makes them). A test release only while there is no full
# one; "main" while there is no release at all.
newest_release() {
    local tags
    tags=$(git -C "$CODE" tag --list 'v[0-9]*' --sort=-v:refname)
    grep -m1 -E '^v[0-9]+(\.[0-9]+)*$' <<<"$tags" \
        || grep -m1 -E '^v[0-9]+(\.[0-9]+)*(a|b|rc)[0-9]+$' <<<"$tags" \
        || echo main
}

get_code() {
    local installed=''
    if [[ -d $CODE/.git ]]; then
        installed=$(git -C "$CODE" rev-parse HEAD)
        step "Getting ${REF:-the newest release} from $REPO"
        git -C "$CODE" remote set-url origin "$REPO"
        git -C "$CODE" fetch --quiet --tags --force origin
    else
        step "Getting PaperPi from $REPO into $CODE"
        mkdir -p "$PREFIX"
        git clone --quiet "$REPO" "$CODE"
    fi
    if [[ -z $REF ]]; then
        REF=$(newest_release)
    fi
    # A branch name means the newest commit of that branch on GitHub.
    local target=$REF
    if git -C "$CODE" rev-parse --verify --quiet "refs/remotes/origin/$REF" >/dev/null; then
        target=origin/$REF
    fi
    # Going back, e.g. from main to the last release, is allowed; just say so.
    if [[ -n $installed ]] && ! git -C "$CODE" merge-base --is-ancestor "$installed" "$target" 2>/dev/null; then
        echo "    Note: this is not newer than the code installed now (${installed:0:7});" \
            "--ref main gets the newest code."
    fi
    git -C "$CODE" -c advice.detachedHead=false checkout --quiet --force "$target" \
        || fail "no branch, tag or commit $REF in $REPO"
    printf '    %s: %s\n' "$REF" "$(git -C "$CODE" log -1 --format='%h %s')"
}

install_packages() {
    step "Installing PaperPi's Python packages into $VENV"
    # The system's Python (it gets Debian's security updates), never a downloaded one; the
    # exact versions of uv.lock; no development tools. PaperPi itself is always built again:
    # uv would keep the old copy while the version number stays the same (issue #319).
    (cd "$CODE" && UV_PROJECT_ENVIRONMENT=$VENV UV_PYTHON=/usr/bin/python3 \
        UV_PYTHON_DOWNLOADS=never UV_CACHE_DIR=$PREFIX/cache \
        "$TOOLS/bin/uv" sync --quiet --frozen --no-dev --no-editable --reinstall-package paperpi)
    ln -sfn "$VENV/bin/paperpi" "$COMMAND"
    # Kept outside $CODE, so the next update can't change it while it runs.
    install -m 0755 "$CODE/install/paperpi-install" "$SELF"
}

make_config() {
    install -d -o "$USER_NAME" -g "$USER_NAME" -m 0750 "$CONFIG_DIR"
    if [[ -e $CONFIG ]]; then
        step "Keeping the config $CONFIG"
        return
    fi
    step "Writing a first config to $CONFIG: a clock and the set-up screen"
    local options=(--setup --display "$DISPLAY_TYPE")
    if [[ -n $MODEL ]]; then options+=(--model "$MODEL"); fi
    if [[ -n $VCOM ]]; then options+=(--vcom "$VCOM"); fi
    # As the PaperPi user: the web interface must be able to change the file.
    runuser -u "$USER_NAME" -- "$VENV/bin/paperpi" example-config "${options[@]}" -o "$CONFIG"
}

install_service() {
    step "Installing the service file $UNIT"
    install -m 0644 "$CODE/install/paperpi.service" "$UNIT"
    systemctl daemon-reload
}

wait_for_start() {
    # "systemctl restart" returns once PaperPi says READY=1, or fails.
    if ! systemctl is-active --quiet paperpi; then
        fail "the service did not start; see: journalctl -u paperpi -n 50"
    fi
    echo
    echo "PaperPi runs.${1:+ $1}"
    echo "Logs: journalctl -u paperpi -f    Status: systemctl status paperpi"
}

cmd_install() {
    check_system
    choose_screen
    get_apt_packages
    turn_on_spi
    make_user
    get_uv
    get_code
    install_packages
    make_config
    install_service
    systemctl enable --quiet paperpi
    if [[ $RESTART == yes ]]; then
        step "PaperPi starts at every start of the Pi; SPI works after a restart of the Pi"
        if [[ $ASK == yes ]] && yes_no "    Restart the Pi now?"; then
            systemctl reboot
        else
            echo "    Restart it when you are ready: sudo reboot"
        fi
        return
    fi
    step "Starting PaperPi, also at every start of the Pi"
    systemctl restart paperpi
    if [[ $DISPLAY_TYPE == virtual ]]; then
        local address
        address=$(hostname -I | cut -d' ' -f1)
        wait_for_start "Open http://${address:-$(hostname).local}:8080 to set it up."
    else
        wait_for_start "The screen shows the web address to set it up."
    fi
}

cmd_update() {
    check_system
    [[ -d $CODE/.git ]] || fail "PaperPi is not installed; use: sudo paperpi-install install"
    get_apt_packages
    get_uv
    get_code
    install_packages
    install_service
    step "Restarting PaperPi"
    systemctl restart paperpi
    wait_for_start
}

cmd_uninstall() {
    [[ $EUID -eq 0 ]] || fail "run it with sudo"
    step "Stopping the service (this clears the screen, up to 45 seconds)"
    systemctl disable --now --quiet paperpi 2>/dev/null || true
    rm -f "$UNIT"
    systemctl daemon-reload
    step "Removing $PREFIX, $COMMAND and $SELF"
    rm -rf "$PREFIX"
    rm -f "$COMMAND" "$SELF"
    if [[ $PURGE == yes ]]; then
        step "Removing $CONFIG_DIR, $STATE_DIR and the user $USER_NAME"
        rm -rf "$CONFIG_DIR" "$STATE_DIR"
        userdel "$USER_NAME" 2>/dev/null || true
    else
        echo "Kept: $CONFIG_DIR (config, web password) and $STATE_DIR (saved files)."
    fi
}

main() {
    # "curl ... | sudo bash -s -- --ref main": options without a command.
    local command=''
    if [[ $# -gt 0 && $1 != -[!h]* ]]; then
        command=$1
        shift
    fi
    DISPLAY_TYPE='' MODEL='' VCOM='' PURGE=no RESTART=no ASK=yes
    while [[ $# -gt 0 ]]; do
        case $1 in
            --ref) REF=${2:?--ref needs a value}; shift 2 ;;
            --repo) REPO=${2:?--repo needs a value}; shift 2 ;;
            --display) DISPLAY_TYPE=${2:?--display needs a value}; shift 2 ;;
            --model) MODEL=${2:?--model needs a value}; shift 2 ;;
            --vcom) VCOM=${2:?--vcom needs a value}; shift 2 ;;
            --yes) ASK=no; shift ;;
            --purge) PURGE=yes; shift ;;
            -h | --help) usage; exit 0 ;;
            *) usage >&2; fail "unknown option: $1" ;;
        esac
    done
    # No terminal to ask in (e.g. run by another program): as --yes.
    if [[ $ASK == yes ]] && ! { true </dev/tty; } 2>/dev/null; then
        ASK=no
    fi
    # "curl ... | sudo bash" gives no command.
    if [[ -z $command ]]; then
        [[ ! -d $CODE/.git ]] \
            || fail "PaperPi is installed already; to update it: sudo paperpi-install update"
        command=install
    fi
    case $command in
        install) cmd_install ;;
        update) cmd_update ;;
        uninstall) cmd_uninstall ;;
        -h | --help | help) usage ;;
        *) usage >&2; exit 2 ;;
    esac
}

# Nothing reads the script's input: with "curl ... | bash" that is the rest of this file.
main "$@" </dev/null
exit
